[Unit]
Description=Lokal kartserver (go-pmtiles) på 127.0.0.1:8081
# Port 8080 används av Oden.
ConditionPathExists=%h/.oden-persist
ConditionPathExists=/srv/oden-assets/maps

[Service]
# TODO: kontrollera flaggsyntax mot pinnad go-pmtiles-version
ExecStart=/opt/pmtiles/pmtiles serve /srv/oden-assets/maps --port 8081 --bind 127.0.0.1 --cors=app://obsidian.md
Restart=on-failure

[Install]
WantedBy=default.target
