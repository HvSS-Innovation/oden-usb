#!/bin/bash
# Skapar partitionen "persistence" i det lediga utrymmet efter ISO-datan på den stick vi bootade från.
# Behövs när stickan är bränd med t.ex. Etcher: bara ISO-storleken skrivs, resten är oallokerat.
# Rör inga befintliga partitioner. Gör inget om en partition "persistence" redan finns.
# Exit 0: finns eller skapad. Exit 1: kan inte skapas (skälet skrivs på stderr).
# Testvariabler: ODEN_DISK (disk eller avbildsfil), ODEN_MINFREE_MB (standard 8192), ODEN_NOPARTX=1.
set -euo pipefail
S=sudo; [[ $EUID -eq 0 || -n "${ODEN_DISK:-}" ]] && S=""   # ODEN_DISK = testfil, behöver inte root
MINFREE_MB="${ODEN_MINFREE_MB:-8192}"
die() { echo "oden-make-persist: $*" >&2; exit 1; }

disk="${ODEN_DISK:-}"
if [[ -z "$disk" ]]; then
  src=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
  [[ -n "$src" ]] || die "hittar inte boot-mediet (/run/live/medium)"
  pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 || true)
  [[ -n "$pk" ]] || die "boot-mediet $src är ingen partition på en disk (optisk skiva?)"
  disk="/dev/$pk"
fi

$S sgdisk -p "$disk" >/dev/null 2>&1 || die "$disk har ingen läsbar GPT"
if $S sgdisk -p "$disk" | awk '$1 ~ /^[0-9]+$/ {print $NF}' | grep -qx persistence; then exit 0; fi

# Etcher m.fl. lägger sikthuvudet (backup-GPT) vid ISO:ns slut. Flytta det till diskens slut.
$S sgdisk -e "$disk" >/dev/null 2>&1 || die "kunde inte flytta GPT-sikthuvudet på $disk"

first=$($S sgdisk -F "$disk"); last=$($S sgdisk -E "$disk")
free_mb=$(( (last - first + 1) * 512 / 1048576 ))
(( free_mb >= MINFREE_MB )) || die "för lite ledigt utrymme efter ISO-datan: $free_mb MiB, kräver minst $MINFREE_MB MiB. Använd en större stick."

$S sgdisk -a 2048 -n 0:0:0 -t 0:8309 -c 0:persistence "$disk" >/dev/null 2>&1 || die "kunde inte skapa partitionen"

if [[ "${ODEN_NOPARTX:-}" != 1 ]]; then
  # p1 är monterad, så hela tabellen kan inte läsas om (partprobe/BLKRRPART misslyckas). Lägg bara till den nya.
  n=$($S sgdisk -p "$disk" | awk '$NF=="persistence" {print $1}')
  $S partx -a -n "$n" "$disk" 2>/dev/null || true
  $S udevadm settle 2>/dev/null || true
fi
