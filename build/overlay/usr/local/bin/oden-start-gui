#!/bin/sh
# Autostart: bara med upplåst persistens (steg 03).
if [ ! -f "$HOME/.oden-persist" ]; then
  # Notisen visas bara när p4 faktiskt är krypterad men inte upplåst. Är p4 tom pågår förstastarten
  # (oden-firstboot) och den ber själv om lösenfras.
  part=$(oden-persist-dev 2>/dev/null) || exit 0
  [ "$(sudo blkid -s TYPE -o value "$part" 2>/dev/null)" = crypto_LUKS ] &&
    notify-send "Data inte upplåst" "Starta om och ange lösenfras." 2>/dev/null
  exit 0
fi
case "$1" in
  browser)  sleep 3; exec firefox-esr --new-window http://127.0.0.1:8080 ;;
  obsidian) exec /opt/obsidian/obsidian ;;
esac
