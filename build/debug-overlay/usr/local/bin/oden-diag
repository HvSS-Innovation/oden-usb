#!/bin/bash
# FELSÖKNINGSBILD (ODEN_DEBUG=1): skriver systemets tillstånd till tty1 och växlar dit, så att det syns utan inloggning.
o=/run/oden-diag.txt
{
  echo "=== oden-diag $(date) ==="
  echo "--- cmdline"; cat /proc/cmdline
  echo "--- getent passwd oden"; getent passwd oden || echo "(FINNS INTE)"
  echo "--- shadow (utan hash): namn lstchg min max warn inact expire"; getent shadow oden | awk -F: '{print $1, $3, $4, $5, $6, $7, $8, ($2 ~ /^[!*]/ ? "LÅST" : "hash:" length($2) " tecken")}'
  echo "--- login/pam (journal)"; journalctl -b --no-pager -t login -t agetty -t pam_unix -t lightdm 2>&1 | tail -8 | cut -c1-150
  echo "--- state-filer live-config"; ls /var/lib/live/config 2>&1 | tr '\n' ' '; echo
  echo "--- autologin"; grep -h "^autologin" /etc/lightdm/lightdm.conf /etc/lightdm/lightdm.conf.d/* 2>&1 | head -5
  echo "--- failed units"; systemctl --failed --no-legend --no-pager 2>&1 | head -10
  echo "--- live-config (sista rader)"; journalctl -b --no-pager -u live-config 2>&1 | tail -12 | cut -c1-150
  echo "--- fel i journalen"; journalctl -b --no-pager -p err 2>&1 | tail -15 | cut -c1-150
  echo "--- lightdm"; tail -12 /var/log/lightdm/lightdm.log 2>&1 | cut -c1-150
  echo "--- mounts"; findmnt -rno TARGET,SOURCE | grep -E "home|persist|medium|oden" | head
  echo "--- lsblk"; lsblk -o NAME,SIZE,PARTLABEL,FSTYPE 2>&1
} > "$o" 2>&1
systemctl mask --runtime --now getty@tty1.service autovt@tty1.service >/dev/null 2>&1
chvt 1
sleep 1
clear > /dev/tty1
cat "$o" > /dev/tty1
