#!/bin/sh
# Körs i chroot vid bygget.
set -e

# Tjänster som ska vara av
for u in hibernate.target hybrid-sleep.target suspend-then-hibernate.target \
         apt-daily.timer apt-daily-upgrade.timer man-db.timer \
         avahi-daemon.service cups.service cups-browsed.service bluetooth.service; do
  systemctl mask "$u" 2>/dev/null || true
done

# Utan user-setup hoppar live-config över 0030-user-setup: ingen användare, ingen inloggning.
dpkg -s user-setup >/dev/null 2>&1 || { echo "FEL: user-setup saknas (live-config kan inte skapa användaren)" >&2; exit 1; }

# Ingen "Logga ut": autologin gäller bara vid uppstart, så efter utloggning visar LightDM en inloggningsruta som kräver lösenord.
# Panelens åtgärdsknapp släpper bara fram Lås skärm, Starta om och Stäng av; Ctrl+Alt+Delete (utloggningsdialogen) tas bort.
# Lås skärm kör oden-lock (xfce4-session LockCommand): upplåsning med krypteringslösenordet, se overlayns pam.d/xfce4-screensaver.
# Menyvalet i Program-menyn döljs av overlayns /usr/local/share/applications/xfce4-session-logout.desktop (NoDisplay).
panel=/etc/xdg/xfce4/panel/default.xml
perl -0pi -e 's{<property name="plugin-10" type="string" value="actions"/>}{<property name="plugin-10" type="string" value="actions">\n      <property name="items" type="array">\n        <value type="string" value="+lock-screen"/>\n        <value type="string" value="-switch-user"/>\n        <value type="string" value="-separator"/>\n        <value type="string" value="-suspend"/>\n        <value type="string" value="-hibernate"/>\n        <value type="string" value="-hybrid-sleep"/>\n        <value type="string" value="+separator"/>\n        <value type="string" value="+shutdown"/>\n        <value type="string" value="+restart"/>\n        <value type="string" value="-separator"/>\n        <value type="string" value="-logout"/>\n        <value type="string" value="-logout-dialog"/>\n      </property>\n    </property>}' "$panel"
grep -q 'value="-logout-dialog"' "$panel" || { echo "FEL: åtgärdsknappen i $panel gick inte att ändra (plugin-10 saknas?)" >&2; exit 1; }
sk=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
sed -i '/xfce4-session-logout/d' "$sk"
! grep -q 'xfce4-session-logout' "$sk" || { echo "FEL: genvägen till utloggning finns kvar i $sk" >&2; exit 1; }

ss=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml
sed -i 's#<property name="LockCommand" type="string" value=""/>#<property name="LockCommand" type="string" value="oden-lock lock"/>#' "$ss"
grep -q 'value="oden-lock lock"' "$ss" || { echo "FEL: LockCommand gick inte att sätta i $ss" >&2; exit 1; }
grep -q 'value="+lock-screen"' "$panel" || { echo "FEL: Lås skärm är inte påslagen i $panel" >&2; exit 1; }
[ -f /etc/pam.d/xfce4-screensaver ] && grep -q 'oden-lock pam-check' /etc/pam.d/xfce4-screensaver || { echo "FEL: PAM-tjänsten xfce4-screensaver saknar oden-lock (overlayn skriver över paketets fil)" >&2; exit 1; }

# Brandvägg och tidssynk på
systemctl enable nftables.service systemd-timesyncd.service oden-assets.service oden-wifi-prep.service oden-usb-watch.service oden-ramcache.service

# Användartjänster (oden/pmtiles/ollama) startas för alla användare; villkor i unit-filerna
systemctl --global enable oden.service pmtiles.service ollama.service

# Skrivskyddade installationsplatser skapas av build.sh (staging); skapa mappar här så att units inte faller på saknad sökväg
mkdir -p /opt/oden /opt/obsidian /opt/pmtiles /opt/ollama /opt/oden-template /srv/oden-assets

# Firefox läser policies.json från distribution/ (kravet: inga nätanrop utöver de tillåtna). Finns den inte där, länka;
# saknas den helt avbryts bygget i stället för att leverera en Firefox som ringer hem.
d=/usr/lib/firefox-esr/distribution
[ -e "$d/policies.json" ] || { mkdir -p "$d"; ln -s /etc/firefox-esr/policies/policies.json "$d/policies.json"; }
[ -s "$d/policies.json" ] || { echo "FEL: Firefox-policies saknas" >&2; exit 1; }

# Plymouth-temat oden = spinner (snurra, lösenfrasdialog) med egen logga och färger (overlayn har oden.plymouth + watermark.png).
t=/usr/share/plymouth/themes
for f in "$t"/spinner/*; do [ -e "$t/oden/$(basename "$f")" ] || cp -a "$f" "$t/oden/"; done
[ -s "$t/oden/oden.plymouth" ] && [ -s "$t/oden/watermark.png" ] && [ -s "$t/oden/entry.png" ] || { echo "FEL: plymouth-temat oden är ofullständigt" >&2; exit 1; }
plymouth-set-default-theme oden

# Initramfs byggs om efter att overlayn (keymap, krypteringsinställningar) lagts in.
update-initramfs -u -k all

# SBOM (paketdelen)
mkdir -p /usr/share/oden
dpkg-query -W -f='${binary:Package} ${Version}\n' | sort > /usr/share/oden/SBOM-packages.txt
